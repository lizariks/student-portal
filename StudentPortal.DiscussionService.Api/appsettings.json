{
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "studentportal-discussion-service-db",
    "MaxConnectionPoolSize": 100,
    "MinConnectionPoolSize": 5,
    "ConnectTimeoutSeconds": 10,
    "SocketTimeoutSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "Secret": "A_VERY_LONG_AND_SECURE_SECRET_KEY_FOR_JWT_THAT_IS_AT_LEAST_32_CHARACTERS_LONG",
    "Issuer": "StudentPortal.IdentityService",
    "Audience": "StudentPortal.Services",
    "AccessTokenDurationMinutes": 15,
    "RefreshTokenDurationDays": 7
  },
  "AllowedHosts": "*"
}
